generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES
  ADS_MANAGER
  CLIENT
  USER
}

enum RequestStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  BOOLEAN
  SELECT
  FILE
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true)

  serviceRequests  ServiceRequest[] @relation("UserRequests")
  assignedRequests ServiceRequest[] @relation("AssignedRequests")
  blogPosts        BlogPost[]
  blogLikes        BlogLike[]
  blogComments     BlogComment[]
  blogShares       BlogShare[]
  notifications    Notification[]
  payments         Payment[]
  permissions      UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  users       UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Service {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  description String?
  isActive    Boolean          @default(true)
  fields      ServiceField[]
  requests    ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model ServiceField {
  id         Int       @id @default(autoincrement())
  serviceId  Int
  label      String
  key        String
  type       FieldType
  isRequired Boolean   @default(false)
  options    String?
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceId, key])
}

model ServiceRequest {
  id           Int           @id @default(autoincrement())
  userId       Int
  serviceId    Int
  assignedToId Int?
  status       RequestStatus @default(NEW)
  priority     Priority      @default(MEDIUM)
  title        String?
  message      String?       @db.Text

  user        User                 @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo  User?                @relation("AssignedRequests", fields: [assignedToId], references: [id])
  service     Service              @relation(fields: [serviceId], references: [id])
  requestData ServiceRequestData[]
  files       FileUpload[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ServiceRequestData {
  id        Int            @id @default(autoincrement())
  requestId Int
  fieldKey  String
  value     String         @db.Text
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model FileUpload {
  id        Int            @id @default(autoincrement())
  requestId Int
  fileName  String
  fileUrl   String
  docFileId String?
  fileType  String?
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BlogPost {
  id        Int           @id @default(autoincrement())
  title     String
  slug      String        @unique
  content   String        @db.Text
  thumbnail String?
  fieldId   String?
  status    BlogStatus    @default(DRAFT)
  views     Int           @default(0)
  authorId  Int
  author    User          @relation(fields: [authorId], references: [id])
  likes     BlogLike[]
  comments  BlogComment[]
  shares    BlogShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BlogLike {
  id     Int      @id @default(autoincrement())
  postId Int
  userId Int?
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model BlogComment {
  id         Int      @id @default(autoincrement())
  comment    String   @db.Text
  postId     Int
  userId     Int
  isApproved Boolean  @default(true)
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BlogShare {
  id       Int      @id @default(autoincrement())
  postId   Int
  userId   Int?
  platform String?
  post     BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Ad {
  id         Int     @id @default(autoincrement())
  placement  String
  adType     String
  adCode     String? @db.Text
  imageUrl   String?
  targetUrl  String?
  clientName String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  message String  @db.Text
  status  String  @default("NEW")

  createdAt DateTime @default(now())
}

model Notification {
  id      Int     @id @default(autoincrement())
  userId  Int
  title   String
  message String
  isRead  Boolean @default(false)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Payment {
  id               Int            @id @default(autoincrement())
  userId           Int
  serviceRequestId Int
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("USD")
  status           PaymentStatus  @default(PENDING)
  transactionId    String?
  paymentMethod    String?
  user             User           @relation(fields: [userId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  createdAt DateTime @default(now())
}
